<?xml version="1.0" encoding="UTF-8"?>
<blueprint xmlns="http://www.osgi.org/xmlns/blueprint/v1.0.0"
           xmlns:cm="http://aries.apache.org/blueprint/xmlns/blueprint-cm/v1.1.0">

  <!-- Konfiguracja z ConfigAdmin (etc/pl.isp.allegro.cfg); ponizej wartosci domyslne. -->
  <cm:property-placeholder persistent-id="pl.isp.allegro" update-strategy="reload">
    <cm:default-properties>
      <cm:property name="rabbitmq.host" value="localhost"/>
      <cm:property name="rabbitmq.port" value="5672"/>
      <cm:property name="rabbitmq.username" value="guest"/>
      <cm:property name="rabbitmq.password" value="guest"/>
      <cm:property name="scheduler.cron" value="0/20+*+*+*+*+?"/>
      <cm:property name="products.file" value=""/>
    </cm:default-properties>
  </cm:property-placeholder>

  <bean id="catalog" class="pl.isp.allegro.scheduler.ProductCatalog">
    <argument value="${products.file}"/>
  </bean>
  <bean id="routes" class="pl.isp.allegro.scheduler.SchedulerRoutes">
    <property name="catalog" ref="catalog"/>
  </bean>

  <camelContext id="pricing-scheduler" xmlns="http://camel.apache.org/schema/blueprint">
    <routeBuilder ref="routes"/>
  </camelContext>
</blueprint>
